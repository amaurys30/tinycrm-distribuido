# =====================================================================
# PLANTILLA de variables de la Maquina 1.
# Copien este archivo como ".env" (Copy-Item .env.example .env) y cambien
# los valores ANTES del primer arranque: las BD se crean con estas claves.
# =====================================================================
# IP de ESTE portatil en el WiFi/hotspot (ipconfig -> Direccion IPv4 del
# adaptador Wi-Fi). El DNS responde www.tiny.com con esta IP.
IP_MAQUINA1=10.0.0.100

# Cluster de BD (Percona XtraDB Cluster)
PXC_ROOT_PASSWORD=CambiarRootCluster
DB_CLIENTE_A_PASSWORD=CambiarClienteA
DB_CLIENTE_B_PASSWORD=CambiarClienteB

# BD central Usuarios
USUARIOS_ROOT_PASSWORD=CambiarRootUsuarios
MIDDLEWARE_DB_PASSWORD=CambiarMiddleware
CONSUMER_DB_PASSWORD=CambiarConsumer

# Broker RabbitMQ
RABBITMQ_USER=tinycrm
RABBITMQ_PASSWORD=CambiarBroker

# Middleware
MIDDLEWARE_SECRETO=cambien-esta-frase-secreta-larga-y-aleatoria
