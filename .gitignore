node_modules/
**/dist/
**/build/
**/.gradle/
*.jar
*.class

# Python
__pycache__/
*.pyc

# ---------------------------------------------------------------
# Editores y sistema operativo
# ---------------------------------------------------------------
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini
*.log
